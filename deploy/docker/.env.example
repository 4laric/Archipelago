# Copy to .env and edit. docker compose reads this automatically.

# --- required ---
DOMAIN=peliarch.ca                 # hostname pointing at this box (auto-HTTPS). Local test: DOMAIN=:80
PUBLIC_HOST=peliarch.ca                  # what players see in connect addresses (domain or public IP)
ACME_EMAIL=you@example.com               # Let's Encrypt contact (ignored when DOMAIN=:80)
DONATION_URL=https://buymeacoffee.com/your-handle

# --- room port range (the orchestrator allocates here; compose maps the same range) ---
# width = max CONCURRENT running rooms. 64 is plenty for a 4 GB box. Keep START<END.
PORT_START=38400
PORT_END=38463

# --- optional ---
COMPOSE_PROJECT_NAME=peliarch
UPLOAD_MAX_BYTES=67108864                # 64 MB upload cap
LOG_TAIL_LINES=200
