# Copy to .env and edit. docker compose reads this automatically.

# --- required ---
DOMAIN=peliarch.ca                 # hostname pointing at this box (auto-HTTPS). Local test: DOMAIN=:80
PUBLIC_HOST=peliarch.ca                  # what players see in connect addresses (domain or public IP)
ACME_EMAIL=you@example.com               # Let's Encrypt contact (ignored when DOMAIN=:80)
DONATION_URL=https://buymeacoffee.com/your-handle

# --- room port range (the orchestrator allocates here; compose maps the same range) ---
# width = max CONCURRENT running rooms. 64 is plenty for a 4 GB box. Keep START<END.
PORT_START=38400
PORT_END=38463

# --- optional ---
COMPOSE_PROJECT_NAME=peliarch
UPLOAD_MAX_BYTES=67108864                # 64 MB upload cap
LOG_TAIL_LINES=200

# --- Elden Ring tooling (baked into the image at build time; see the Dockerfile's `ertools` stage) ---
# ER_REF is the reproducibility boundary: the same ref always builds the same apworld + wizard.
# Pin it to a release tag for a box you care about; `main` tracks the tip.
ER_REPO=https://github.com/4laric/er-archipelago.git
ER_REF=main

# --- seed generation (POST /generate) ---
# 🛑 This is the one endpoint that runs a program over text a stranger wrote. The limits below are
# the boundary, not a tuning exercise -- see webgui/generator.py. A real per-IP rate limit belongs
# in front of it, in Caddy, and is NOT included yet (the base caddy:2 image has no ratelimit module).
GENERATE_ENABLED=1
GENERATE_TIMEOUT=180                     # wall seconds; the child is killed by process group
GENERATE_MAX_AS_MB=2048                  # RLIMIT_AS the child cannot raise (a solo ER seed peaks ~170 MB)
GENERATE_PLANDO=                         # empty = plando off, which is the right public default
