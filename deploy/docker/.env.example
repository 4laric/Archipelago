# Copy to .env and edit. docker compose reads this automatically.

# --- required ---
DOMAIN=peliarch.ca                 # hostname pointing at this box (auto-HTTPS). Local test: DOMAIN=:80
PUBLIC_HOST=peliarch.ca                  # what players see in connect addresses (domain or public IP)
ACME_EMAIL=you@example.com               # Let's Encrypt contact (ignored when DOMAIN=:80)
DONATION_URL=https://buymeacoffee.com/fazuzu

# Shown in the header/footer of every page. A Discord handle is not a link -- the footer
# renders it as copyable text -- so put the handle here, not a URL. Blank hides the item.
CONTACT_DISCORD=@rickyquick
CONTACT_GITHUB=https://github.com/4laric/archipelago

# --- /downloads: where the Elden Ring mod itself comes from ---
# Peliarch hosts rooms; er-archipelago publishes the game, on its own tags. The page reads the
# newest release off the GitHub API rather than restating a version here -- release/DISTRIBUTION.md
# makes GitHub Releases the single source of truth, and a version pinned in this file would be one
# more surface to forget to bump. Any fetch failure degrades to a plain link to the releases index.
DOWNLOADS_REPO=4laric/er-archipelago
NEXUS_URL=https://www.nexusmods.com/eldenring/mods/10334
GAME_GITHUB_URL=https://github.com/4laric/er-archipelago
# Cache lifetime and API timeout, both in seconds. The measured tag cadence upstream is a 0.82-day
# median gap, so 15 minutes is already far finer than the thing it tracks, and it keeps an
# unauthenticated box at 4 calls/hour against GitHub's anonymous 60/hour budget.
DOWNLOADS_TTL_SECONDS=900
DOWNLOADS_TIMEOUT_SECONDS=4
# Optional, and NOT needed -- a public repo's releases read fine anonymously. Only set it if this
# box shares an egress IP with something else that burns the anonymous budget.
#
# ** Leave it COMMENTED OUT rather than blank. ** An inline comment on a line whose value is empty
# is not stripped from a compose env_file: `FOO=   # note` sets FOO to "# note". That is exactly
# how GENERATE_PLANDO once shipped a comment into --plando and broke every generation on the box.
#DOWNLOADS_GITHUB_TOKEN=ghp_xxx

# --- room port range (the orchestrator allocates here; compose maps the same range) ---
# width = max CONCURRENT running rooms. 64 is plenty for a 4 GB box. Keep START<END.
PORT_START=38400
PORT_END=38463

# --- optional ---
COMPOSE_PROJECT_NAME=peliarch
UPLOAD_MAX_BYTES=67108864                # 64 MB upload cap
LOG_TAIL_LINES=200

# --- Elden Ring tooling (baked into the image at build time; see the Dockerfile's `ertools` stage) ---
# ER_REF is the reproducibility boundary: the same ref always builds the same apworld + wizard.
# Pin it to a release tag for a box you care about; `main` tracks the tip.
ER_REPO=https://github.com/4laric/er-archipelago.git
ER_REF=main

# --- seed generation (POST /generate) ---
# 🛑 This is the one endpoint that runs a program over text a stranger wrote. The limits below are
# the boundary, not a tuning exercise -- see webgui/generator.py. A real per-IP rate limit belongs
# in front of it, in Caddy, and is NOT included yet (the base caddy:2 image has no ratelimit module).
GENERATE_ENABLED=1
GENERATE_TIMEOUT=180                     # wall seconds; the child is killed by process group
GENERATE_MAX_AS_MB=2048                  # RLIMIT_AS the child cannot raise (a solo ER seed peaks ~170 MB)
# empty = plando off, which is the right public default.
#
# 🛑 KEEP THIS COMMENT ON ITS OWN LINE. Written inline as
# `GENERATE_PLANDO=    # empty = plando off, ...` the box came up with the COMMENT TEXT as the
# value, and every generation died with
#   KeyError: '# empty = plando off is not a recognized name for a plando module'
# because Generate.py's --plando is comma-split by BaseClasses.PlandoOptions.from_option_string.
# The non-empty settings above are unaffected -- which is why the app still booted and the site
# still served, and why this reads as a generation bug rather than a config one.
GENERATE_PLANDO=

# --- /generate rate limit (Caddy, github.com/mholt/caddy-ratelimit, per client IP) ---
# The per-generation limits bound ONE request; they say nothing about how many arrive. A loop of
# valid yamls is a loop of valid, individually-limited generations, and the CPU is gone either way.
# Defaults are shaped by measurement: a real solo seed takes ~1.5-3 s, so 3/min leaves the box ~95%
# idle even with a client sitting at the ceiling, and is more than any human wizard user asks for.
# IPv6 clients are bucketed by /64, since one client owns the whole prefix.
GENERATE_RATE_EVENTS=3
GENERATE_RATE_WINDOW=1m
